# ============================================================
# JERA — Environment Variables
# Copy this file to .env.local (frontend) and backend/.env
# NEVER commit .env files to source control
# ============================================================

# ─── Frontend (Next.js) ──────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://jera-journal.org
NEXT_PUBLIC_API_URL=https://api.jera-journal.org

# NextAuth
NEXTAUTH_URL=https://jera-journal.org
NEXTAUTH_SECRET=your-super-secret-nextauth-key-min-32-chars

# ─── Backend (Express) ───────────────────────────────────────
NODE_ENV=production
PORT=4000
FRONTEND_URL=https://jera-journal.org

# PostgreSQL (Supabase / Neon / Railway)
DATABASE_URL=postgresql://user:password@host:5432/jera_db?sslmode=require

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Cloudflare R2 Storage
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=jera-manuscripts
R2_PUBLIC_URL=https://files.jera-journal.org

# Email (SMTP / Resend / SendGrid)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=your-api-key
EMAIL_FROM=editor@jera-journal.org

# Google Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
